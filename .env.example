# Browser requests should stay same-origin and go through Next.js rewrites.
# This URL is used by the Next.js server/runtime to proxy /api/v1/* to the backend.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: use an internal/private backend URL in production containers
# while keeping the public browser origin unchanged.
INTERNAL_API_URL=http://localhost:3001

# App Info
NEXT_PUBLIC_APP_NAME=DevOps Blog
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SEO: canonical site URL used for sitemap, robots.txt, and meta tags.
# Set to your production domain in deployment.
NEXT_PUBLIC_SITE_URL=https://blog.thienduong.info

# Optional Sentry browser monitoring
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_APP_ENV=development
