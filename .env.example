# Browser requests should stay same-origin and go through Next.js rewrites.
# This URL is used by the Next.js server/runtime to proxy /api/v1/* to the backend.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: use an internal/private backend URL in production containers
# while keeping the public browser origin unchanged.
INTERNAL_API_URL=http://localhost:3001

# App Info
NEXT_PUBLIC_APP_NAME=DevOps Blog
NEXT_PUBLIC_APP_URL=http://localhost:3000
https://api.blog.thienduong.info
	
https://blog.thienduong.info
